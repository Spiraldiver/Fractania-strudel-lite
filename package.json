{
  "name": "fractania-strudel-lite",
  "version": "0.1.1",
  "description": "Live-codable 3D fractals for strudel.cc — WebGL2 Mandelbulb raymarcher, pattern-driven",
  "type": "module",
  "main": "dist/fractania-strudel-lite.js",
  "scripts": {
    "build": "esbuild src/index.mjs --bundle --format=esm --outfile=dist/fractania-strudel-lite.js",
    "dev": "esbuild src/index.mjs --bundle --format=esm --outfile=dist/fractania-strudel-lite.js --watch",
    "serve": "python tools/test_server.py 8124"
  },
  "keywords": ["strudel", "hydra", "fractal", "mandelbulb", "raymarching", "webgl2", "livecoding"],
  "author": "Spiraldiver",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
